# Copy this file to backend/.env and replace development values before deployment.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/funding_innovation_platform
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: enables live patent search via PatentsView.
PATENTSVIEW_API_KEY=
