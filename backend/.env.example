# Copy this file to .env and fill in your own local values
# Postgres (Docker container — see docker-compose.yml for port mapping)
DATABASE_URL=postgresql://innovafund_user:innovafund_pass@localhost:5433/innovafund_db

# MongoDB (Docker container)
MONGO_URL=mongodb://localhost:27018

# Auth
SECRET_KEY=replace_with_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60